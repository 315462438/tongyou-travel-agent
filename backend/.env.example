# 复制为 backend/.env 后填入真实值。**.env 不进版本库**（见 .gitignore）。
# 各项密钥找项目管理员索取。

# 数据库：远程 PostgreSQL，必须走 SSH 隧道，不能公网直连
# （原因见 docs/pitfalls/远程PostgreSQL公网直连被重置.md）
# 先跑 backend/scripts/db_tunnel.sh，再启动后端
DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/travel_agent

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型分层：规划/抽取用 pro，分类用 flash
MODEL_PLANNER=deepseek-v4-pro
MODEL_EXTRACTOR=deepseek-v4-pro
MODEL_CLASSIFIER=deepseek-v4-flash

# Agent 专用调试 Chrome（端口 9223 + 独立 profile）
# 先跑 backend/scripts/start_chrome.sh
CHROME_DEBUG_URL=http://127.0.0.1:9223

# 高德地图 Web 服务（天气/POI/坐标/静态图）
AMAP_KEY=
AMAP_SECRET=

# 深度研究模式（本地默认关，服务器开）
DEEP_RESEARCH_ENABLED=false

# 注册邀请码：留空 = 开放注册（本地开发用）
REGISTER_INVITE_CODE=

# 首次启动引导管理员账号用。**必填，没有默认值**——留空会直接拒绝启动。
# 本项目刻意不提供默认管理员口令：代码是公开的，默认值等于所有部署共用同一个密码，
# 而登录时的「请修改默认口令」只是提示、不拦登录。
# 已经引导过管理员的部署不受影响（那条分支只在「还没有管理员」时才走）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 部署目标（`deploy.sh` / `db_tunnel.sh` 从这里读；也可用同名环境变量覆盖）。
# 服务器地址不写进仓库——仓库公开，等于给出明确目标。
DEPLOY_HOST=ubuntu@your-server
