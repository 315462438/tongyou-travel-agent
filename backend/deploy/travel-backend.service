[Unit]
Description=Travel Browser Agent Backend (FastAPI :8000)
After=network.target postgresql.service travel-chrome.service
Wants=travel-chrome.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/travel-agent/backend
ExecStart=/home/ubuntu/travel-agent/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
