<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/launch_window</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
